# Required: generate a random value, then use the same token in Frontend/.env.
TIMETABLE_BACKEND_TOKEN=

# AI_PROVIDER=deepseek makes real API calls. fixture is an explicit offline demo.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=20

# Exact origins, comma separated. Add the deployed frontend URL when available.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Paths are relative to Backend. Sample data is fictional, never university records.
CATALOGUE_PATH=data/catalogue.json
CATALOGUE_SOURCE=file
# Set postgres to use the Prisma schema, real student lookup and capacity tracking.
POSTGRES_URL=
TERM_ID=2026-fall
DATABASE_PATH=instance/enrolment.sqlite3
SOLVER_TIMEOUT_SECONDS=3
MAX_SOLVER_NODES=200000
SWAP_WINDOW_DAYS=14
