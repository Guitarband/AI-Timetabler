DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/timetable"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Set false for local development without mail, or for the sample-data MVP demo
# when AUTH_ALLOW_UNVERIFIED_DEMO=true and NEXT_PUBLIC_USE_MOCK=true.
AUTH_REQUIRE_EMAIL_VERIFICATION="true"
# Production-only demo opt-in. Never enable with the real planner backend.
AUTH_ALLOW_UNVERIFIED_DEMO="false"
# Configure a server-side mail webhook for verification and password resets.
# It must accept POST JSON { to, subject, text } with a Bearer token and return 2xx.
AUTH_EMAIL_WEBHOOK_URL=""
AUTH_EMAIL_WEBHOOK_TOKEN=""

# Full URL of the backend timetable calculation endpoint.
TIMETABLE_BACKEND_URL=""
TIMETABLE_BACKEND_TOKEN=""

# Planner demo uses sample course data; sign-in is still required.
NEXT_PUBLIC_USE_MOCK="true"
# Must match Backend TERM_ID; course onboarding and the solver share this term.
TERM_ID="2026-fall"
# Base URL for /context, /parse, /solve, /adjust and /confirm in real mode.
# Requests use TIMETABLE_BACKEND_TOKEN and session-derived X-User-Id/X-User-Name.
# See ../Backend/README.md; the token must match Backend/.env.
ENROLMENT_BACKEND_URL="http://127.0.0.1:8000"
